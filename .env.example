# ── Supabase ──────────────────────────────────────────────────────────────
# Backend / service role key. Server-side + local scanner ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=<your-supabase-secret-key>

# Fill these in once the project is created (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Vault ─────────────────────────────────────────────────────────────────
VAULT_PATH=/Users/josephtey/Library/Mobile Documents/iCloud~md~obsidian/Documents/Life
VAULT_FOLDERS=Ever Green Learnings,Ever Green Notes

# ── Hosting ───────────────────────────────────────────────────────────────
# Optional. Unset = open. Set it (locally or on Vercel) to gate every page and API route behind
# one password; the browser gets a cookie that lasts a year.
LOCI_PASSWORD=

# ── Ollama (recall mode's auto-grader) ────────────────────────────────────
# Local by default: the grader runs on this machine, costs nothing per card, and no answer you
# type leaves the laptop. Install Ollama, then `ollama pull qwen3.5:4b`.
OLLAMA_HOST=http://127.0.0.1:11434

# On a hosted deployment there is no laptop, so point at Ollama's hosted service instead. Key
# from https://ollama.com/settings/keys — only ever sent to a non-local host.
#   OLLAMA_HOST=https://ollama.com
#   OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# Overrides `graderModel` in prompts/config.json. Needed when hosted, because that file is
# committed and read-only there — and the local default (qwen3.5:4b) doesn't exist on the cloud.
# Measured on the free tier: gpt-oss:120b grades 18/18 in ~0.7s. nemotron-3-nano:30b gets 13/18.
OLLAMA_MODEL=
