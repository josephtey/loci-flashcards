# ── Supabase ──────────────────────────────────────────────────────────────
# Backend / service role key. Server-side + local scanner ONLY. Never expose to the browser.
SUPABASE_SECRET_KEY=<your-supabase-secret-key>

# Fill these in once the project is created (Supabase dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Vault ─────────────────────────────────────────────────────────────────
VAULT_PATH=/Users/josephtey/Library/Mobile Documents/iCloud~md~obsidian/Documents/Life
VAULT_FOLDERS=Ever Green Learnings,Ever Green Notes

# ── Hosting ───────────────────────────────────────────────────────────────
# Set this on a hosted copy (Vercel etc.). Every page and API route is gated behind it; the browser
# gets a cookie that lasts a year. Leave unset locally and nothing is gated.
LOCI_PASSWORD=
